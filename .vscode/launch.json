{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Learnly (app.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against Learnly (http://localhost:5000)",
            "url": "http://localhost:5000",
            "webRoot": "${workspaceFolder}"
        }
    ]
}